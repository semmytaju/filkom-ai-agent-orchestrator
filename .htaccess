Options -Indexes -Multiviews
ServerSignature Off

ErrorDocument 400 /REINFORCEMENTLEARNING/filkom-ai-agent-orchestrator/index.php?url=errors/index/400
ErrorDocument 401 /REINFORCEMENTLEARNING/filkom-ai-agent-orchestrator/index.php?url=errors/index/401
ErrorDocument 403 /REINFORCEMENTLEARNING/filkom-ai-agent-orchestrator/index.php?url=errors/index/403
ErrorDocument 404 /REINFORCEMENTLEARNING/filkom-ai-agent-orchestrator/index.php?url=errors/index/404
ErrorDocument 405 /REINFORCEMENTLEARNING/filkom-ai-agent-orchestrator/index.php?url=errors/index/405
ErrorDocument 500 /REINFORCEMENTLEARNING/filkom-ai-agent-orchestrator/index.php?url=errors/index/500
ErrorDocument 503 /REINFORCEMENTLEARNING/filkom-ai-agent-orchestrator/index.php?url=errors/index/503

<IfModule mod_headers.c>
    Header always set Permissions-Policy "geolocation=(self), camera=(self), microphone=(self)"
</IfModule>

<LimitExcept GET POST HEAD OPTIONS>
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Allow,Deny
        Deny from all
    </IfModule>
</LimitExcept>

<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Allow,Deny
        Deny from all
    </IfModule>
</FilesMatch>

<FilesMatch "(?i)\.(sql|bak|backup|old|tmp|temp|log|env.*|ini|conf|config|yml|yaml|lock|sh|ps1|bat|cmd|git.*|svn.*)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Allow,Deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteCond %{REQUEST_METHOD} ^(TRACE|TRACK) [NC]
    RewriteRule .* - [F,L]

    RewriteRule ^(?:app|database|storage)(?:/.*)?$ index.php?url=errors/forbidden [L]

    RewriteRule ^assets/(.*)$ public/assets/$1 [L]
    RewriteRule ^uploads/(.*)$ public/uploads/$1 [L]
    RewriteRule ^css/(.*)$ public/assets/css/$1 [L]
    RewriteRule ^js/(.*)$ public/assets/js/$1 [L]
    RewriteRule ^img/(.*)$ public/assets/img/$1 [L]

    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    RewriteRule ^(.*)$ index.php?url=$1 [QSA,L]
</IfModule>
